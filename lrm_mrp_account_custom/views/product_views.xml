<odoo>

    <record id="product_product_ext_form_view2" model="ir.ui.view">
        <field
            name="name"
        >product_extended.product.form.view (in lrm_mrp_account_custom)</field>
        <field name="model">product.template</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="groups_id" eval="[(4, ref('mrp.group_mrp_manager'))]" />
        <field name="arch" type="xml">
            <button name="button_bom_cost" position="replace">
                <field name="lrm_is_subcontracted" invisible="1" />
                <button
                    name="button_bom_cost"
                    string="Compute Price from BoM"
                    type="object"
                    attrs="{'invisible': ['|', ('lrm_is_subcontracted', '=', True), '|', ('bom_count', '=', 0), '&amp;', ('valuation', '=', 'real_time'), ('cost_method', '=', 'fifo')]}"
                    help="Compute the price of the product using products and operations of related bill of materials, for manufactured products only."
                    class="oe_link oe_read_only pt-0"
                />
                <button
                    name="action_subcontract_bom_cost"
                    string="Compute Price from Subcontract"
                    type="object"
                    attrs="{'invisible': [('lrm_is_subcontracted', '=', False)]}"
                    help="Compute the price of the product using bill of materials and subcontract price, for subcontracted products only."
                    class="oe_link oe_read_only pt-0"
                />
            </button>
        </field>
    </record>

