    <record id="action_compute_price_subcontract_template" model="ir.actions.server">
        <field name="name">Compute Price from Subcontract</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
        if records:
            records.action_subcontract_bom_cost()
        </field>
    </record>

