#. module: lrm_mrp_account_custom
#: model_terms:ir.ui.view,arch_db:lrm_mrp_account_custom.product_product_ext_form_view2
#: model_terms:ir.ui.view,arch_db:lrm_mrp_account_custom.product_product_view_form_normal_inherit_extended
#: model_terms:ir.ui.view,arch_db:lrm_mrp_account_custom.product_variant_easy_edit_view_bom_inherit
msgid ""
"Compute the price of the product using bill of materials and subcontract "
"price, for subcontracted products only."
msgstr "Calcula o preço do produto usando a lista de materiais e o preço da "
"subcontratação, somente para produtos subcontratados."

#. module: lrm_mrp_account_custom
#: model_terms:ir.ui.view,arch_db:lrm_mrp_account_custom.product_product_ext_form_view2
#: model_terms:ir.ui.view,arch_db:lrm_mrp_account_custom.product_product_view_form_normal_inherit_extended
#: model_terms:ir.ui.view,arch_db:lrm_mrp_account_custom.product_variant_easy_edit_view_bom_inherit
msgid ""
"Compute the price of the product using products and operations of related "
"bill of materials, for manufactured products only."
msgstr "Calcula o preço do produto usando os componentes e operações da lista "
"de materiais relacionada, somente para produtos fabricados."

